# Normalize line endings: LF in the repository, native on checkout except where noted.
* text=auto eol=lf
Makefile text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cff text eol=lf
*.md text eol=lf
*.mmd text eol=lf
*.csv text eol=lf
*.pcap binary
*.pcapng binary
*.png binary
*.gz binary
